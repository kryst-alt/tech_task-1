# Copy to .env, or run `make setup` to create it with generated secrets.

# --- Shared by lead-api and sheets-sync -----------------------------------
DATABASE_URL=postgres://leads:leads@localhost:5432/leads?sslmode=disable

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# `make setup` fills these from a downloaded client_secret_*.json in the project root.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the stored Google refresh token. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- lead-api ---------------------------------------------------------------
# Shared with the partner. Generate with: openssl rand -hex 32
LEAD_SIGNING_SECRET=
# Bearer token for admin endpoints and the Google sign-in link. Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# --- Optional (defaults shown) -----------------------------------------------
# PORT=8080
# DB_PORT=5432
# LOG_LEVEL=info
# SIGNATURE_TOLERANCE=5m
# GOOGLE_REDIRECT_URL=http://localhost:${PORT}/auth/google/callback
# SYNC_INTERVAL=2s
# SYNC_BATCH_SIZE=50
