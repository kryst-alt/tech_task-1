{
  "info": {
    "name": "Lead Management API",
    "description": "Demo and test collection for the lead API. Import together with the environment, fill in signingSecret and adminApiKey (or generate the environment with scripts/postman-env.sh), then run the whole collection in the Collection Runner.\n\nEvery POST /v1/leads is signed automatically by the collection's pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Signs POST /v1/leads the way the partner does:",
          "// X-Signature = \"sha256=\" + hex(HMAC-SHA256(secret, timestamp + \".\" + raw body))",
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString(36));",
          "}",
          "if (pm.request.method === \"POST\" && pm.request.url.getPath() === \"/v1/leads\") {",
          "  const secret = pm.environment.get(\"signingSecret\");",
          "  if (!secret) throw new Error(\"Set signingSecret in the environment (LEAD_SIGNING_SECRET from .env)\");",
          "  const body = pm.variables.replaceIn(pm.request.body.raw);",
          "  const timestamp = Math.floor(Date.now() / 1000).toString();",
          "  const signature = CryptoJS.HmacSHA256(timestamp + \".\" + body, secret).toString(CryptoJS.enc.Hex);",
          "  pm.request.headers.upsert({ key: \"X-Timestamp\", value: timestamp });",
          "  pm.request.headers.upsert({ key: \"X-Signature\", value: \"sha256=\" + signature });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "runId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Database and Google link status. `google` should be `ok` once the sheet is connected.\n\nAlso starts a new run: every lead below gets fresh ids, so the collection can be run again and again."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database is ok\", () => pm.expect(pm.response.json().database).to.eql(\"ok\"));",
                  "pm.test(\"google is linked\", () => pm.expect(pm.response.json().google).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
