    {
      "name": "2. Signature check (R1.2, R4.1)",
      "item": [
        {
          "name": "No signature",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "leads"
              ]
            },
            "description": "The signature headers are removed before sending.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"pm-{{runId}}-x1\",\n  \"name\": \"Eve\",\n  \"email\": \"eve1.{{runId}}@example.com\",\n  \"company\": \"Acme\",\n  \"source\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"X-Signature\");",
                  "pm.request.headers.remove(\"X-Timestamp\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong secret",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "leads"
              ]
            },
            "description": "Signed with a secret the server doesn't know, as an attacker would have to.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"pm-{{runId}}-x2\",\n  \"name\": \"Eve\",\n  \"email\": \"eve2.{{runId}}@example.com\",\n  \"company\": \"Acme\",\n  \"source\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const ts = pm.request.headers.get(\"X-Timestamp\");",
                  "const sig = CryptoJS.HmacSHA256(ts + \".\" + body, \"wrong-secret\").toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Signature\", value: \"sha256=\" + sig });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Body changed after signing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "leads"
              ]
            },
            "description": "Correctly signed, then the email is swapped in transit. The signature no longer matches the body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"pm-{{runId}}-x3\",\n  \"name\": \"Eve\",\n  \"email\": \"eve3.{{runId}}@example.com\",\n  \"company\": \"Acme\",\n  \"source\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.raw = pm.variables.replaceIn(pm.request.body.raw).replace(\"eve3.\", \"attacker.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Old timestamp (replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "leads"
              ]
            },
            "description": "Correct signature, but made 10 minutes ago. Stops someone recording a real request and resending it later.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"pm-{{runId}}-x4\",\n  \"name\": \"Eve\",\n  \"email\": \"eve4.{{runId}}@example.com\",\n  \"company\": \"Acme\",\n  \"source\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const ts = (Math.floor(Date.now() / 1000) - 600).toString();",
                  "const sig = CryptoJS.HmacSHA256(ts + \".\" + body, pm.environment.get(\"signingSecret\")).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Timestamp\", value: ts });",
                  "pm.request.headers.upsert({ key: \"X-Signature\", value: \"sha256=\" + sig });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
